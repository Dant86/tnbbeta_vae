# Copy to .env (git-ignored) and edit for your machine or cluster.
# Real environment variables take precedence over values in .env.

# Where CIFAR-10 is downloaded to and read from.
TNBBETA_DATA_DIR=./data

# Where model checkpoints are written (one subdirectory per run name).
TNBBETA_CHECKPOINT_DIR=./checkpoints

# Where run configs and metric logs are written (one subdirectory per run).
TNBBETA_RUNS_DIR=./runs
